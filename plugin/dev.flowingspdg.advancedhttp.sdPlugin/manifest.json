{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "dev.flowingspdg.advancedhttp",
  "Name": "HTTP Client [MikanseiLaboratory]",
  "Author": "MikanseiLaboratory",
  "Description": "Send HTTP requests from Stream Deck keys and dials.",
  "Version": "1.0.0.0",
  "Icon": "images/icon",
  "Category": "HTTP Client [MikanseiLaboratory]",
  "CategoryIcon": "images/icon",
  "CodePath": "bin/plugin",
  "CodePathWin": "bin/plugin.exe",
  "CodePathMac": "bin/plugin",
  "PropertyInspectorPath": "propertyinspector/index.html",
  "SDKVersion": 3,
  "URL": "https://github.com/MikanseiLaboratory/streamdeck-advanced-http",
  "Software": {
    "MinimumVersion": "6.9"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    },
    {
      "Platform": "mac",
      "MinimumVersion": "10.15"
    }
  ],
  "Actions": [
    {
      "UUID": "dev.flowingspdg.advancedhttp.get",
      "Name": "HTTP GET",
      "Icon": "images/icon",
      "Tooltip": "Send an HTTP GET request when the key is pressed or released.",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": true,
      "States": [
        {
          "Image": "images/icon",
          "TitleAlignment": "middle",
          "FontSize": 24
        }
      ]
    },
    {
      "UUID": "dev.flowingspdg.advancedhttp.dial.get",
      "Name": "HTTP GET (Dial)",
      "Icon": "images/icon",
      "Tooltip": "Send an HTTP GET request when the dial turns, is pressed, or is tapped.",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "$B1",
        "TriggerDescription": {
          "Rotate": "Send request",
          "Push": "Send request",
          "Touch": "Send request"
        }
      },
      "States": [
        {
          "Image": "images/icon"
        }
      ]
    },
    {
